#include <iostream>

using std::cout;
using std::cin;
using std::endl;

int main() {

	int age, height;

	cout << "Enter your age: ";
	cin >> age;
	
	cout << "Enter your height in inches: ";
	cin >> height;
	
	if (age < 0 || height < 0) {
		cout << "Age/height cannot be negative." << endl;
	}
	else if (age >= 16 && height >= 54) {
		cout << "You can ride any ride here!" << endl;
	}
	else if (height >= 36 || age >= 8) {
		cout << "You can ride most rides here!" << endl;
	}
	else {
		cout << "You cannot ride any rides here." << endl;
	}

	return 0;
}